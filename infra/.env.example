# Street Blackjack Radio - server settings (NOT secrets).
# On the server this file lives at /opt/sbradio/config/sbradio.env
#
# Test VPS without a domain yet: use free sslip.io hostnames built from the server IP,
# e.g. for IP 51.89.12.34 -> radio.51-89-12-34.sslip.io
# Production: real subdomains whose DNS A records point at the server.

RADIO_DOMAIN=radio.example.com
API_DOMAIN=api.radio.example.com
PLAYER_DOMAIN=player.radio.example.com

# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com

# Browser origins allowed to call the registry API (comma-separated).
# Add the game's domain(s) later, e.g. https://play.streetblackjack.com
CORS_ORIGINS=https://player.radio.example.com
